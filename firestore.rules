rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth == null || request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return request.auth == null || request.auth.uid == resource.data.authorUid;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'crop', 'price', 'location', 'authorUid', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.crop is string && data.crop.size() > 0 &&
             data.price is number && data.price >= 0 &&
             data.location is string && data.location.size() > 0 &&
             (request.auth == null || data.authorUid == request.auth.uid);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'phone', 'role', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.phone is string && data.phone.size() > 0 &&
             data.role in ['farmer', 'buyer', 'admin'];
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'receiverId', 'text', 'createdAt']) &&
             (request.auth == null || data.senderId == request.auth.uid) &&
             data.senderName is string && data.senderName.size() > 0 &&
             data.receiverId is string && data.receiverId.size() > 0 &&
             data.text is string && data.text.size() > 0 && data.text.size() < 1000;
    }

    function isValidCartItem(data) {
      return data.keys().hasAll(['productId', 'name', 'price', 'quantity', 'sellerId', 'sellerName']) &&
             data.productId is string &&
             data.name is string &&
             data.price is number && data.price >= 0 &&
             data.quantity is number && data.quantity > 0 &&
             data.sellerId is string &&
             data.sellerName is string;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['buyerId', 'buyerName', 'items', 'totalAmount', 'status', 'paymentMethod', 'paymentStatus', 'createdAt', 'address', 'phone', 'sellerIds']) &&
             (request.auth == null || data.buyerId == request.auth.uid) &&
             data.buyerName is string && data.buyerName.size() > 0 &&
             data.items is list && data.items.size() > 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             data.paymentMethod in ['upi', 'card', 'netbanking', 'cod'] &&
             data.paymentStatus in ['pending', 'paid', 'failed'] &&
             data.address is string && data.address.size() > 0 && data.address.size() < 500 &&
             data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15 &&
             data.sellerIds is list && data.sellerIds.size() > 0;
    }

    function isAdmin() {
      return request.auth != null && 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
              (request.auth.token.email == "saiprasadwagh57@gmail.com" && request.auth.token.email_verified == true));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentDetails', 'walletBalance', 'language']) || isValidUser(request.resource.data));

      match /cart/{cartId} {
        allow read: if true;
        allow write: if isOwner(userId) && (request.method == 'DELETE' || isValidCartItem(request.resource.data));
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isValidProduct(request.resource.data);
      allow update: if isValidProduct(request.resource.data);
      allow delete: if isDocOwner() || isAdmin() || request.auth == null;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if isValidMessage(request.resource.data);
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidOrder(request.resource.data);
      allow update: if true;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    match /transactions/{transactionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }
  }
}
